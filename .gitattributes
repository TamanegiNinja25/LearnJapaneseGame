# Normalise text to LF in the repo; Godot and the Python tools read LF everywhere.
* text=auto eol=lf

*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.import  text eol=lf
*.uid     text eol=lf
*.cfg     text eol=lf
*.json    text eol=lf
*.tsv     text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.svg     text eol=lf

# Binary assets
*.png     binary
*.jpg     binary
*.glb     binary
*.bin     binary
*.ttf     binary
*.otf     binary
*.wav     binary
*.ogg     binary
