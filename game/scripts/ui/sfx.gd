extends Node
class_name Sfx
## Sound effects and the background loop. main.gd adds one Sfx node; screens call the static
## play() from anywhere. Silent when 設定 › 効果音 / 音楽 are off, before main exists (tests),
## and while the OS text-to-speech voice is talking (music ducks for listening).
##
## Sounds are generated by tools/make_sounds.gd into assets/audio/.

const SOUNDS := ["correct", "wrong", "stroke", "complete", "levelup"]
const SFX_DB := -6.0
const MUSIC_DB := -16.0
const DUCK_DB := -30.0

static var _instance: Sfx

var _players: Array[AudioStreamPlayer] = []
var _streams: Dictionary = {}
var _music: AudioStreamPlayer
var _next := 0


func _ready() -> void:
	_instance = self
	process_mode = Node.PROCESS_MODE_ALWAYS
	for name: String in SOUNDS:
		var path := "res://assets/audio/%s.wav" % name
		if ResourceLoader.exists(path):
			_streams[name] = load(path)
	for i in 4:
		var p := AudioStreamPlayer.new()
		p.volume_db = SFX_DB
		add_child(p)
		_players.append(p)
	_music = AudioStreamPlayer.new()
	_music.volume_db = MUSIC_DB
	var loop_path := "res://assets/audio/music_loop.wav"
	if ResourceLoader.exists(loop_path):
		var stream := load(loop_path) as AudioStreamWAV
		if stream:
			stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
			stream.loop_begin = 0
			stream.loop_end = int(stream.get_length() * stream.mix_rate)
			_music.stream = stream
	add_child(_music)
	apply_settings()


func _exit_tree() -> void:
	if _instance == self:
		_instance = null


## Play one effect by name ("correct", "wrong", "stroke", "complete", "levelup").
static func play(name: String) -> void:
	if _instance == null or not bool(Progress.setting("sfx")):
		return
	_instance._play(name)


## Start or stop the loop to match 設定 › 音楽.
static func refresh() -> void:
	if _instance:
		_instance.apply_settings()


func apply_settings() -> void:
	if _music.stream == null:
		return
	var want := bool(Progress.setting("music"))
	if want and not _music.playing:
		_music.play()
	elif not want and _music.playing:
		_music.stop()


func _play(name: String) -> void:
	var stream: AudioStream = _streams.get(name)
	if stream == null:
		return
	var p := _players[_next]
	_next = (_next + 1) % _players.size()
	p.stream = stream
	p.play()


func _process(_delta: float) -> void:
	# Duck the music under the text-to-speech voice so listening practice stays clear.
	if _music.playing:
		var target := DUCK_DB if Speech.is_speaking() else MUSIC_DB
		_music.volume_db = move_toward(_music.volume_db, target, 1.5)
